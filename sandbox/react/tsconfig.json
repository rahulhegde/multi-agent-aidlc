{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "module": "ESNext", "moduleResolution": "Bundler",
    "isolatedModules": true, "noEmit": true, "jsx": "react-jsx"
  },
  "include": ["src"]
}
